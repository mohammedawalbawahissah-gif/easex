DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=easex_db
POSTGRES_USER=easex_user
POSTGRES_PASSWORD=easex_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Generate your own: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); v.save_key('private.pem')"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@easex.example

CORS_ALLOWED_ORIGINS=http://localhost:5173

# manual = admin confirms loads / sends payouts by hand (safe default).
# stub   = fake instant payments, local development only (refused if DEBUG is off).
PAYMENTS_PROVIDER=manual

# Gift card payout rates are set per subcategory in Django admin (or with
# `manage.py set_giftcard_rates`), not here.

# ---------------------------------------------------------------------------
# Security  (see the "Security" section of PAYMENTS.md before deploying)
# ---------------------------------------------------------------------------
# REQUIRED in production. Rate limits and lockouts live here so every web worker shares them.
# (Celery uses database 0; the cache uses database 1 of the same server automatically.)
REDIS_URL=redis://redis:6379/0

# REQUIRED in production. Encrypts gift card codes and 2FA secrets. Generate ONE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the NEW key first, comma-separated, e.g. NEWKEY,OLDKEY. Never lose a key that still
# protects data.
FIELD_ENCRYPTION_KEYS=

# Set both ONCE to long random strings, and NEVER change them afterwards (changing PIN_PEPPER invalidates
# every user's PIN and 2FA recovery codes; changing the fingerprint key weakens duplicate-card detection).
# If left empty they fall back to DJANGO_SECRET_KEY, which then can't be rotated either.
PIN_PEPPER=
GIFTCARD_FINGERPRINT_KEY=

# Staff must use 2FA for the admin tools. Enable YOUR 2FA in the app (Account -> Security) before turning
# this on, or you will lock yourself out of the admin tools.
REQUIRE_STAFF_2FA=True

# After a password reset / PIN change / 2FA change, money can't leave the account for this many hours.
SECURITY_COOLING_OFF_HOURS=24

# Unreviewed gift card codes are erased after this many days (approved/rejected cards are erased at once).
GIFTCARD_CODE_RETENTION_DAYS=30

# Move Django's built-in admin off /admin/ (it also requires an authenticator code).
ADMIN_URL=admin/

# Password-reset emails need a real mail server in production (the default just prints them to the log).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
