DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Docker Compose uses these discrete vars. On Railway, the managed
# Postgres plugin provides a single DATABASE_URL instead, which takes
# priority over all of these when it's set — see config/settings.py.
POSTGRES_DB=easex_db
POSTGRES_USER=easex_user
POSTGRES_PASSWORD=easex_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL=postgres://user:pass@host:port/dbname

REDIS_URL=redis://redis:6379/0

# apps.support (AI customer assistant) and apps.risk (KYC/gift-card vision
# checks, admin copilot). If unset, support escalates every session straight
# to a human and risk's vision assists simply produce no assessment — neither
# breaks without it, but neither is actually AI-assisted either.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Email (password resets, security alerts, receipts)
# ---------------------------------------------------------------------------
# console just logs emails — fine for local dev. In production, use resend
# (or sendgrid / ses / postmark / mailgun — all supported via Anymail).
EMAIL_PROVIDER=console
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@easex.app
# Must point at wherever the web app's /reset-password page actually lives.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Mobile money — Hubtel (MTN MoMo / Telecel Cash / AirtelTigo Money)
# ---------------------------------------------------------------------------
# Off by default (PAYMENTS_PROVIDER=manual above still governs the overall
# safe default). Turn this on only once you have real Hubtel merchant
# credentials and a public HTTPS callback URL for HUBTEL_CALLBACK_URL.
HUBTEL_ENABLED=False
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_POS_SALES_ID=
HUBTEL_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Media storage — Cloudflare R2 (gift card images, KYC documents)
# ---------------------------------------------------------------------------
# REQUIRED in production — Railway's local disk doesn't persist across
# redeploys. Leave blank for local dev; files fall back to local disk.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
# Optional: the public r2.dev URL or custom domain mapped to the bucket.
R2_PUBLIC_BASE_URL=

# Generate your own: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); v.save_key('private.pem')"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@easex.example

CORS_ALLOWED_ORIGINS=http://localhost:5173

# manual = admin confirms loads / sends payouts by hand (safe default).
# stub   = fake instant payments, local development only (refused if DEBUG is off).
PAYMENTS_PROVIDER=manual

# Gift card payout rates are set per subcategory in Django admin (or with
# `manage.py set_giftcard_rates`), not here.

# ---------------------------------------------------------------------------
# Security  (see the "Security" section of PAYMENTS.md before deploying)
# ---------------------------------------------------------------------------
# REDIS_URL above is REQUIRED in production — rate limits and lockouts live
# there so every web worker shares them. (Celery uses database 0; the cache
# uses database 1 of the same server automatically.)

# REQUIRED in production. Encrypts gift card codes and 2FA secrets. Generate ONE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the NEW key first, comma-separated, e.g. NEWKEY,OLDKEY. Never lose a key that still
# protects data.
FIELD_ENCRYPTION_KEYS=

# Set both ONCE to long random strings, and NEVER change them afterwards (changing PIN_PEPPER invalidates
# every user's PIN and 2FA recovery codes; changing the fingerprint key weakens duplicate-card detection).
# If left empty they fall back to DJANGO_SECRET_KEY, which then can't be rotated either.
PIN_PEPPER=
GIFTCARD_FINGERPRINT_KEY=

# Staff must use 2FA for the admin tools. Enable YOUR 2FA in the app (Account -> Security) before turning
# this on, or you will lock yourself out of the admin tools.
REQUIRE_STAFF_2FA=True

# After a password reset / PIN change / 2FA change, money can't leave the account for this many hours.
SECURITY_COOLING_OFF_HOURS=24

# Unreviewed gift card codes are erased after this many days (approved/rejected cards are erased at once).
GIFTCARD_CODE_RETENTION_DAYS=30

# Move Django's built-in admin off /admin/ (it also requires an authenticator code).
ADMIN_URL=admin/
